# ---- тайминги ----
# как часто проверять появление сеансов (секунды)
POLL_SECONDS=90
# интервал напоминаний после находки (3600 = раз в час)
REMIND_SECONDS=3600
# сколько раз напомнить, потом бот отстанет
MAX_REMINDERS=12
# сколько живёт бронь на сайте до повторного захода (секунды)
HOLD_SECONDS=600

# ---- автобронь (без этого бронировать нечем) ----
# телефон в формате +998XXXXXXXXX — на него оформляется бронь
BOOK_PHONE=+998330079969
# почта для чека, можно оставить пустой
BOOK_EMAIL=playbestgames11@gmail.com

# ---- любимые места по залам ----
# кусок названия зала : ряды по убыванию желания @ центральное место
# 13.5 = между 13 и 14, значит 2 места -> 13,14; 4 места -> 12,13,14,15
# * — все остальные залы
SEAT_ANCHORS=imax:7,8,6@13.5; atmos:5,6,4@10.5; *:4,5@5

# ---- аккаунт cinematica.uz (необязательно, для скидочной карты) ----
